{
  "name": "dsh-plugin-peepface",
  "version": "2.0.0",
  "description": "会看你的 DSH 头像：26 种形状、任意颜色、22 个状态（引擎移植自 Grok Bot）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "keywords": ["dsh-plugin", "avatar", "peepface"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  }
}
